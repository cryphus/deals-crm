{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "root": "..", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "tests/**", "*.json", "*.ts", "index.html", "!package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        },
        "useHookAtTopLevel": "error"
      }
    }
  }
}
