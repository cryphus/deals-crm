{
  "name": "deals-crm-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:regression": "node tests/polling-save-race.cjs && node tests/streamed-refresh.cjs && node tests/workflows.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
